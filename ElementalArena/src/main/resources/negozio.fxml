<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox alignment="CENTER" spacing="20.0" styleClass="menu-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg126161.controller.NegozioController">

    <Label fx:id="lblTitoloNegozio" text="EMPORIO" styleClass="title-label" style="-fx-font-size: 32px; -fx-padding: 0 0 10 0;"/>

    <HBox alignment="CENTER" spacing="10.0" styleClass="coins-container">
        <Label text="Le tue monete:" styleClass="hero-stat-name"/>
        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
            <image>
                <Image url="@images/coins.png"/>
            </image>
        </ImageView>
        <Label fx:id="lblMonete" text="0" styleClass="hero-stat-gold" style="-fx-font-size: 22px;"/>
    </HBox>

    <Label fx:id="lblFeedback" text="Clicca su Compra sotto l'oggetto desiderato" styleClass="feedback-label"/>

    <ScrollPane fitToWidth="true" prefHeight="350.0" maxWidth="650.0" styleClass="scroll-pane">
        <content>
            <FlowPane fx:id="grigliaArticoli" hgap="20.0" vgap="20.0" alignment="CENTER" style="-fx-padding: 15;"/>
        </content>
    </ScrollPane>

    <Button text="Indietro alla Home" onAction="#handleIndietro" styleClass="menu-button" style="-fx-min-width: 200px; -fx-font-size: 14px;"/>

</VBox>