<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<VBox alignment="CENTER" spacing="20.0" styleClass="menu-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg126161.controller.InventarioController">

    <Label text="INVENTARIO DI GIOCO" styleClass="title-label" style="-fx-font-size: 32px; -fx-padding: 0 0 10 0;"/>

    <Label fx:id="lblFeedback" text="Clicca su Usa/Equipaggia sotto l'oggetto desiderato" styleClass="feedback-label"/>

    <ScrollPane fitToWidth="true" prefHeight="350.0" maxWidth="650.0" styleClass="scroll-pane">
        <content>
            <FlowPane fx:id="grigliaOggetti" hgap="20.0" vgap="20.0" alignment="CENTER" style="-fx-padding: 15;"/>
        </content>
    </ScrollPane>

    <Button text="Indietro alla Home" onAction="#handleIndietro" styleClass="menu-button" style="-fx-min-width: 200px; -fx-font-size: 14px;"/>

</VBox>