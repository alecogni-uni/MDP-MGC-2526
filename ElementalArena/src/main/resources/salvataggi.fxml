<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox alignment="CENTER" spacing="20.0" styleClass="menu-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg126161.controller.SalvataggiController">

    <Label text="SELEZIONA SALVATAGGIO" styleClass="title-label" style="-fx-font-size: 28px;"/>

    <ImageView fitHeight="150.0" fitWidth="150.0" preserveRatio="true">
        <image>
            <Image url="@images/pixel-art-medieval-knight-standing-with-sword-and-shield-wearing-armor-and-red-cape-in-a-fantasy-game-setting-png.png"/>
        </image>
    </ImageView>

    <ScrollPane fitToWidth="true" prefHeight="250.0" maxWidth="600.0" styleClass="scroll-pane">
        <content>
            <FlowPane fx:id="grigliaPartite" hgap="20.0" vgap="20.0" alignment="CENTER" style="-fx-padding: 15;"/>
        </content>
    </ScrollPane>

    <Button text="Indietro al Menu" onAction="#handleIndietro" styleClass="menu-button" style="-fx-min-width: 200px; -fx-font-size: 14px;"/>

</VBox>