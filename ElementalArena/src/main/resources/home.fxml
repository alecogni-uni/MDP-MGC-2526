<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="20.0" styleClass="menu-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg126161.controller.HomeController">

    <Label fx:id="lblDungeon" text="SCONTRO ATTUALE: 1" styleClass="title-label" style="-fx-font-size: 26px; -fx-padding: 0 0 10 0;"/>

    <VBox alignment="CENTER" spacing="10.0" styleClass="hero-card">
        <Label fx:id="lblNome" text="Eroe: -" styleClass="hero-stat-name"/>
        <HBox alignment="CENTER" spacing="20.0">
            <Label fx:id="lblHp" text="HP: - / -" styleClass="hero-stat-hp"/>
            <Label fx:id="lblMonete" text="Monete: 0" styleClass="hero-stat-gold"/>
        </HBox>
        <Label fx:id="lblArma" text="Arma: Mani Nude" styleClass="hero-stat-weapon"/>
    </VBox>

    <VBox alignment="CENTER" spacing="12.0">
        <Button text="AFFRONTA IL PROSSIMO MOSTRO" onAction="#handleCombattimento" styleClass="menu-button, combat-button"/>
        <Button text="VISITA IL NEGOZIO" onAction="#handleNegozio" styleClass="menu-button"/>
        <Button text="APRI INVENTARIO" onAction="#handleInventario" styleClass="menu-button"/>
        <Button text="SALVA PARTITA" onAction="#handleSalva" styleClass="menu-button, save-button"/>
    </VBox>

    <Button text="Esci al Menu Principale" onAction="#handleEsci" styleClass="menu-button" style="-fx-min-width: 200px; -fx-font-size: 14px; -fx-margin-top: 15;"/>

</VBox>